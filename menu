local Library = {}
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local CorrectKey = "0946"

function Library:CreateWindow(config)
    config = config or {}
    local titleText = config.Title or "Universe Script"
    local subTitleText = config.SubTitle or "Cyberpunk Edition"
    
    if CoreGui:FindFirstChild("CPZCyberpunkMenu") then
        CoreGui.CPZCyberpunkMenu:Destroy()
    end
    if CoreGui:FindFirstChild("UniverseKeySystem") then
        CoreGui.UniverseKeySystem:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CPZCyberpunkMenu"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Enabled = false -- Ẩn menu chính lúc đầu để chờ nhập key

    -- Khung chính phong cách Cyberpunk tối
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    MainFrame.Position = UDim2.new(0.5, -290, 0.5, -240)
    MainFrame.Size = UDim2.new(0, 580, 0, 480)
    MainFrame.ClipsDescendants = true

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 8)
    UICorner.Parent = MainFrame

    -- Hiệu ứng viền RGB Cyberpunk chạy quanh khung chính
    local RGBStroke = Instance.new("UIStroke")
    RGBStroke.Parent = MainFrame
    RGBStroke.Thickness = 2
    RGBStroke.Color = Color3.fromRGB(0, 255, 255)

    task.spawn(function()
        local hue = 0
        while RGBStroke and RGBStroke.Parent do
            hue = (hue + 1) % 360
            RGBStroke.Color = Color3.fromHSV(hue / 360, 1, 1)
            task.wait(0.03)
        end
    end)

    -- Thanh tiêu đề trên cùng (Draggable)
    local TopBar = Instance.new("Frame")
    TopBar.Parent = MainFrame
    TopBar.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    TopBar.Size = UDim2.new(1, 0, 0, 45)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = TopBar
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, 15, 0, 0)
    TitleLabel.Size = UDim2.new(0.8, 0, 1, 0)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = "⚡ " .. titleText .. " | " .. subTitleText
    TitleLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left

    -- Kéo thả bảng (Draggable) mượt mà
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- Sidebar chứa danh sách Tab bên trái
    local Sidebar = Instance.new("ScrollingFrame")
    Sidebar.Parent = MainFrame
    Sidebar.BackgroundTransparency = 1
    Sidebar.Position = UDim2.new(0, 10, 0, 55)
    Sidebar.Size = UDim2.new(0, 150, 1, -65)
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    Sidebar.ScrollBarThickness = 2

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.Parent = Sidebar
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 6)

    -- Khu vực hiển thị nội dung bên phải
    local ContentArea = Instance.new("Frame")
    ContentArea.Parent = MainFrame
    ContentArea.BackgroundTransparency = 1
    ContentArea.Position = UDim2.new(0, 170, 0, 55)
    ContentArea.Size = UDim2.new(1, -180, 1, -65)
    ContentArea.ClipsDescendants = true

    -- ==========================================
    -- HỆ THỐNG NHẬP KEY CYBERPUNK CHUYÊN NGHIỆP
    -- ==========================================
    local KeyGui = Instance.new("ScreenGui")
    KeyGui.Name = "UniverseKeySystem"
    KeyGui.Parent = CoreGui
    KeyGui.ResetOnSpawn = false

    local KeyFrame = Instance.new("Frame")
    KeyFrame.Parent = KeyGui
    KeyFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    KeyFrame.Position = UDim2.new(0.5, -210, 0.5, -125)
    KeyFrame.Size = UDim2.new(0, 420, 0, 250)

    local KeyCorner = Instance.new("UICorner")
    KeyCorner.CornerRadius = UDim.new(0, 8)
    KeyCorner.Parent = KeyFrame

    local KeyStroke = Instance.new("UIStroke")
    KeyStroke.Parent = KeyFrame
    KeyStroke.Thickness = 2
    KeyStroke.Color = Color3.fromRGB(0, 255, 255)

    local KeyTitle = Instance.new("TextLabel")
    KeyTitle.Parent = KeyFrame
    KeyTitle.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    KeyTitle.Size = UDim2.new(1, 0, 0, 50)
    KeyTitle.Font = Enum.Font.GothamBold
    KeyTitle.Text = "🔐 XÁC THỰC KEY UNIVERSE SCRIPT"
    KeyTitle.TextColor3 = Color3.fromRGB(0, 255, 255)
    KeyTitle.TextSize = 15

    local KeyTitleCorner = Instance.new("UICorner")
    KeyTitleCorner.CornerRadius = UDim.new(0, 8)
    KeyTitleCorner.Parent = KeyTitle

    local KeyInput = Instance.new("TextBox")
    KeyInput.Parent = KeyFrame
    KeyInput.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    KeyInput.Position = UDim2.new(0, 35, 0, 75)
    KeyInput.Size = UDim2.new(0, 350, 0, 55)
    KeyInput.Font = Enum.Font.Gotham
    KeyInput.PlaceholderText = "Nhập key bảo mật tại đây..."
    KeyInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 140)
    KeyInput.Text = ""
    KeyInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    KeyInput.TextSize = 14

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 6)
    BoxCorner.Parent = KeyInput

    local SubmitBtn = Instance.new("TextButton")
    SubmitBtn.Parent = KeyFrame
    SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
    SubmitBtn.Position = UDim2.new(0, 35, 0, 150)
    SubmitBtn.Size = UDim2.new(0, 350, 0, 55)
    SubmitBtn.Font = Enum.Font.GothamBold
    SubmitBtn.Text = "XÁC NHẬN MỞ KHÓA"
    SubmitBtn.TextColor3 = Color3.fromRGB(15, 15, 20)
    SubmitBtn.TextSize = 14

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = SubmitBtn

    SubmitBtn.MouseButton1Click:Connect(function()
        if KeyInput.Text == CorrectKey then
            KeyGui:Destroy()
            ScreenGui.Enabled = true -- Hiện menu chính sau khi nhập đúng key
        else
            SubmitBtn.Text = "❌ SAI KEY! THỬ LẠI"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            SubmitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            task.wait(1.5)
            SubmitBtn.Text = "XÁC NHẬN MỞ KHÓA"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
            SubmitBtn.TextColor3 = Color3.fromRGB(15, 15, 20)
        end
    end)

    local WindowObj = {}
    local TabsList = {}
    local FirstTab = true

    function WindowObj:AddTab(tabConfig)
        local tabTitle = tabConfig.Title or "Tab"
        
        local TabContainer = Instance.new("ScrollingFrame")
        TabContainer.Parent = ContentArea
        TabContainer.BackgroundTransparency = 1
        TabContainer.Size = UDim2.new(1, 0, 1, 0)
        TabContainer.Visible = FirstTab
        TabContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
        TabContainer.ScrollBarThickness = 3
        TabContainer.ScrollingDirection = Enum.ScrollingDirection.Y

        local TabListLayout = Instance.new("UIListLayout")
        TabListLayout.Parent = TabContainer
        TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        TabListLayout.Padding = UDim.new(0, 8)

        TabListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabContainer.CanvasSize = UDim2.new(0, 0, 0, TabListLayout.AbsoluteContentSize.Y + 15)
        end)

        local TabBtn = Instance.new("TextButton")
        TabBtn.Parent = Sidebar
        TabBtn.BackgroundColor3 = FirstTab and Color3.fromRGB(30, 30, 45) or Color3.fromRGB(20, 20, 28)
        TabBtn.Size = UDim2.new(1, 0, 0, 38)
        TabBtn.Font = Enum.Font.GothamSemibold
        TabBtn.Text = "  " .. tabTitle
        TabBtn.TextColor3 = FirstTab and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(180, 180, 200)
        TabBtn.TextSize = 13
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left

        local TBtnCorner = Instance.new("UICorner")
        TBtnCorner.CornerRadius = UDim.new(0, 6)
        TBtnCorner.Parent = TabBtn

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in pairs(TabsList) do
                t.Container.Visible = false
                t.Button.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
                t.Button.TextColor3 = Color3.fromRGB(180, 180, 200)
            end
            TabContainer.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            TabBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
        end)

        table.insert(TabsList, {Container = TabContainer, Button = TabBtn})
        
        local TabObj = {}

        function TabObj:AddSection(sectionTitle)
            local SecLabel = Instance.new("TextLabel")
            SecLabel.Parent = TabContainer
            SecLabel.BackgroundTransparency = 1
            SecLabel.Size = UDim2.new(1, -10, 0, 25)
            SecLabel.Font = Enum.Font.GothamBold
            SecLabel.Text = ":: " .. string.upper(sectionTitle)
            SecLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
            SecLabel.TextSize = 11
            SecLabel.TextXAlignment = Enum.TextXAlignment.Left
        end

        function TabObj:AddButton(btnConfig)
            local btnTitle = btnConfig.Title or "Button"
            local callback = btnConfig.Callback or function() end

            local Button = Instance.new("TextButton")
            Button.Parent = TabContainer
            Button.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
            Button.Size = UDim2.new(1, -10, 0, 40)
            Button.Font = Enum.Font.Gotham
            Button.Text = "  " .. btnTitle
            Button.TextColor3 = Color3.fromRGB(240, 240, 240)
            Button.TextSize = 12
            Button.TextXAlignment = Enum.TextXAlignment.Left
            Button.AutoButtonColor = false

            local BCorner = Instance.new("UICorner")
            BCorner.CornerRadius = UDim.new(0, 6)
            BCorner.Parent = Button

            Button.MouseEnter:Connect(function()
                Button.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
            end)
            Button.MouseLeave:Connect(function()
                Button.BackgroundColor3 = Color3.fromRGB(22, 22, 32)
            end)

            Button.MouseButton1Click:Connect(function()
                pcall(callback)
                Button.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
                Button.TextColor3 = Color3.fromRGB(15, 15, 20)
                task.wait(0.15)
                Button.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
                Button.TextColor3 = Color3.fromRGB(240, 240, 240)
            end)
        end

        FirstTab = false
        return TabObj
    end

    function WindowObj:SelectTab(index)
        if TabsList[index] then
            for _, t in pairs(TabsList) do
                t.Container.Visible = false
                t.Button.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
                t.Button.TextColor3 = Color3.fromRGB(180, 180, 200)
            end
            TabsList[index].Container.Visible = true
            TabsList[index].Button.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
            TabsList[index].Button.TextColor3 = Color3.fromRGB(0, 255, 255)
        end
    end

    return WindowObj
end

return Library
